{
  "expo": {
    "name": "Blackpine Cabinet",
    "slug": "blackpine-cabinet",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#EFF6FB"
    },
    "ios": {
      "bundleIdentifier": "com.blackpine.cabinet",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Blackpine Cabinet uses the camera to photograph receipts and expense documents.",
        "NSPhotoLibraryUsageDescription": "Blackpine Cabinet accesses your photos to import expense receipts.",
        "NSPhotoLibraryAddUsageDescription": "Blackpine Cabinet saves documents to your photo library.",
        "NSFaceIDUsageDescription": "Blackpine Cabinet uses Face ID to keep your patient data secure."
      }
    },
    "androidStatusBar": {
      "translucent": true,
      "backgroundColor": "#00000000",
      "barStyle": "dark-content"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A4E7E"
      },
      "package": "com.blackpine.cabinet",
      "versionCode": 8,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.VIBRATE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "cameraPermission": "Blackpine Cabinet uses the camera to photograph your receipts and expense documents.",
          "photosPermission": "Blackpine Cabinet accesses your photos to import expense receipts."
        }
      ],
      "expo-local-authentication",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0A4E7E",
          "sounds": []
        }
      ],
      "./plugins/withWidget",
      "expo-secure-store",
      "expo-localization",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "c9495e3a-4c26-4de5-9a9b-41cadcd6e354"
      }
    },
    "web": {
      "privacyPolicyUrl": "https://blackpinecap.com/cabinet/privacy"
    }
  }
}
