{
  "expo": {
    "name": "Blackpine Cabinet",
    "slug": "blackpine-cabinet",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.blackpine.cabinet",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.VIBRATE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.blackpine.cabinet"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "cameraPermission": "L'application a besoin d'accéder à votre caméra pour photographier vos reçus.",
          "photosPermission": "L'application a besoin d'accéder à vos photos pour ajouter des justificatifs."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "c9495e3a-4c26-4de5-9a9b-41cadcd6e354"
      }
    },
    "ios": {
      "bundleIdentifier": "com.blackpine.cabinet"
    },
    "web": {
      "privacyPolicyUrl": "https://derkhamza.github.io/blackpine-legal/"
    }
  }
}
